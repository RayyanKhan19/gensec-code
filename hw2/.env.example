# Copy this file to .env and replace the placeholders locally.
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=replace-with-your-Gemini-API-key
GOOGLE_CLOUD_PROJECT=replace-with-your-Google-Cloud-project-id
GOOGLE_CLOUD_LOCATION=us-west1
# Optional alternative ADC credential configuration:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credential-file.json
